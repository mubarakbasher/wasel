sql {
    driver = "rlm_sql_postgresql"
    dialect = "postgresql"

    server = "${RADIUS_DB_HOST}"
    port = ${RADIUS_DB_PORT}
    login = "${RADIUS_DB_USER}"
    password = "${RADIUS_DB_PASS}"
    radius_db = "${RADIUS_DB_NAME}"

    # Table names
    acct_table1 = "radacct"
    acct_table2 = "radacct"
    postauth_table = "radpostauth"
    authcheck_table = "radcheck"
    groupcheck_table = "radgroupcheck"
    authreply_table = "radreply"
    groupreply_table = "radgroupreply"
    usergroup_table = "radusergroup"

    # Group attribute
    group_attribute = "SQL-Group"

    # NAS clients are loaded ENTIRELY via the dynamic_client_server vserver
    # (see clients.conf and sites-enabled/dynamic-clients), NOT via the
    # boot-time bulk SELECT. read_clients = yes used to coexist with
    # dynamic_clients but caused a footgun: rows loaded at boot become
    # *static* in-memory clients with no TTL, so a delete-then-recreate-
    # same-tunnel-IP swap (or a secret rotation) leaves FR auth'ing
    # against the stale secret forever — dynamic_clients only fires for
    # UNKNOWN IPs, never for already-loaded ones. With read_clients = no
    # every client is dynamic, every row change is picked up within
    # `lifetime` seconds (clients.conf), and there is one source of truth.
    read_clients = no
    client_table = "nas"

    # Use standard PostgreSQL queries
    $INCLUDE ${modconfdir}/sql/main/${dialect}/queries.conf

    # Time to wait for a new Postgres connection before giving up (seconds).
    #
    # Scope note: `connect_timeout` is a module-level directive on rlm_sql
    # in FR 3.2.x (parsed from the sql { } scope, not the pool { } scope);
    # it is placed here on purpose and must not be moved inside pool { }.
    connect_timeout = 5

    pool {
        # Keep the full set of DB connections hot. The thread pool runs
        # 32 workers warm (radiusd.conf → thread pool). The upstream pool
        # documentation shipped with FR 3.2.x (see mods-available/ldap,
        # same rlm_pool code path) says of `max`:
        #
        #   "Setting 'max' to LESS than the number of threads means that
        #    some threads may starve, and you will see errors like 'No
        #    connections available and at max connection limit'.
        #    Setting 'max' to MORE than the number of threads means that
        #    there are more connections than necessary."
        #
        # So max tracks thread[pool].max_servers exactly.
        max = ${thread[pool].max_servers}

        # Start half the pool and keep at least half open. The remaining
        # workers acquire a connection on first use.
        start = 16
        min = 16
        spare = 8
        uses = 0
        lifetime = 0

        # idle_timeout = 0 disables idle reaping. Upstream FR 3.2.x pool
        # docs (mods-available/ldap, same connection-pool code):
        #
        #   "NOTE: Idle connections WILL be closed if 'idle_timeout' is
        #    set."
        #   "All configuration settings are enforced. If a connection is
        #    closed because of 'idle_timeout', 'uses', or 'lifetime', then
        #    the total number of connections MAY fall below 'min'. When
        #    that happens, it will open a new connection. It will also
        #    log a WARNING message. The solution is to either lower the
        #    'min' connections, or increase lifetime/idle_timeout."
        #
        # With min = 16 and the previous idle_timeout = 60, overnight
        # when traffic falls below 16 connections/min the pool would
        # close idle connections then immediately reopen them to meet
        # min — one log WARNING per churn, and a cold Postgres backend
        # for the next request. Setting idle_timeout = 0 keeps all 16
        # min connections resident; 0 is the explicit "no idle reaping"
        # value accepted by rlm_pool.
        idle_timeout = 0

        # Retry a dead connection every 5s instead of the default long
        # back-off, so a Postgres restart recovers in seconds rather
        # than a minute.
        retry_delay = 5
    }
}
